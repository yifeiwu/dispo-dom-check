# Check-Mail.org reputation lookup. Optional: with no key the source reports `unsupported`,
# every other signal is unaffected, and the analysis proceeds without it.
#
# Free tier is 1,000 lookups a month, so bear in mind that each local analysis spends one.
# Obtain a key at https://app.check-mail.org and set the same variable in the Vercel project.
CHECKMAIL_API_KEY=
